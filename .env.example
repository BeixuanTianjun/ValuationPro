# ---------------------------------------------------------------------------
# ValuationPro — konfigurasi layanan lokal
# Salin file ini menjadi `.env` lalu isi nilainya. File `.env` TIDAK ikut
# ter-commit (sudah ada di .gitignore).
# ---------------------------------------------------------------------------

# Port layanan lokal (scheduler + API chatbot + penyaji aplikasi)
PORT=8787

# --- Alert email stock pick -------------------------------------------------
# Dikirim otomatis setelah Sesi I selesai dan setelah pasar tutup.
# Untuk Gmail: aktifkan 2-Step Verification, lalu buat "App Password" 16 huruf
# di https://myaccount.google.com/apppasswords dan tempel di SMTP_PASS.
# JANGAN memakai password akun Gmail Anda yang asli.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=alamat-anda@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
ALERT_EMAIL_FROM=alamat-anda@gmail.com
ALERT_EMAIL_TO=alamat-anda@gmail.com

# Strategi yang dipakai untuk alert harian. Pilihan:
#   balanced-alpha | momentum-breakout | foreign-flow
#   pullback-uptrend | sector-rotation | liquid-turnaround
ALERT_STRATEGY=balanced-alpha

# --- Chatbot ----------------------------------------------------------------
# Opsional. Tanpa key ini chatbot tetap berfungsi penuh memakai mesin query
# lokal. Dengan key, pertanyaan bebas dijawab Claude yang memanggil mesin query
# yang sama sebagai tool — jadi angkanya tetap berasal dari database, bukan
# dari ingatan model.
# ANTHROPIC_API_KEY=sk-ant-...
